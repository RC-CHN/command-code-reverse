# ── Upstream credentials ──────────────────────────────
# Command Code API key(s) from https://commandcode.ai/studio
# Comma-separated for key pool (fill-first: traffic saturates key[0]
# until it is limited/circuit-broken, then spills to the next).
COMMAND_CODE_API_KEY=

# ── Upstream connection ───────────────────────────────
# API base (prod default; staging: https://staging-api.commandcode.ai)
COMMAND_CODE_API_BASE=https://api.commandcode.ai

# CLI version reported in x-command-code-version header.
# Empty = auto-refresh from npm registry every 24h.
# Set COMMAND_CODE_VERSION_PIN to force a fixed version.
COMMAND_CODE_VERSION=
COMMAND_CODE_VERSION_PIN=

# Request zero-data-retention routing upstream: 1/true enables, 0/false disables.
# Unsupported models return CMD_ZDR_NO_PROVIDERS; no fallback without ZDR.
# Invalid boolean values fail startup. This is separate from taste learning.
CMD_ZDR=0

# ── Downstream auth ───────────────────────────────────
# managed:     downstream clients authenticate with PROXY_API_KEY,
#              upstream CC keys stay server-side (recommended for k8s).
# passthrough: downstream clients send their own CC key (legacy mode).
AUTH_MODE=managed
PROXY_API_KEY=

# ── Fingerprint ───────────────────────────────────────
# Report machine fingerprint to /alpha/fingerprint/record (disguise only,
# NOT required by the protocol).
FINGERPRINT_ENABLED=false

# Deterministic derivation seed (k8s-friendly, put in a Secret).
# All components are derived via HMAC-SHA256(seed, component) — identical
# across pod reschedules, no volume needed. Takes priority over state file.
FINGERPRINT_SEED=

# State file for collect-once-replay-forever mode (mount a PVC in k8s).
# Used only when FINGERPRINT_SEED is empty.
FINGERPRINT_STATE_FILE=./data/fingerprint.json

# ── Server ────────────────────────────────────────────
PORT=3050
HOST=0.0.0.0

# Graceful shutdown drain window for in-flight streams (seconds)
SHUTDOWN_DRAIN_SECONDS=30

# ── Limits ────────────────────────────────────────────
# Maximum incoming JSON request size in bytes, including base64 image data.
# Default: 64 MiB. Override at startup for larger requests or a tighter limit.
MAX_BODY_BYTES=67108864
MAX_TOKENS_CLAMP=200000
STREAM_IDLE_TIMEOUT_SECONDS=30
NONSTREAM_IDLE_TIMEOUT_SECONDS=90

# Jev / System One: per-Choice option limit is 20 by default.
# Explicitly unlock up to 255 options. Values above 255 are always rejected.
# These settings are read at startup; invalid values fail startup.
JEV_UNLOCK_MAX_OPTIONS=false
JEV_TIMEOUT_SECONDS=90
# Maximum buffered JSON response from System One, in bytes (default: 8 MiB).
JEV_MAX_RESPONSE_BYTES=8388608

# ── Observability ─────────────────────────────────────
# json or text
LOG_FORMAT=json
LOG_LEVEL=info

# Prometheus metrics endpoint
METRICS_ENABLED=true

# Expose upstream cost in response header x-commandcode-cost
COST_HEADER_ENABLED=false
